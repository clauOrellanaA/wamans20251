<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado activado -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/casiguindo" />
            <corners android:radius="25dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/casiguindo" />
            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="8dp"
                android:bottom="8dp" />
        </shape>
    </item>

    <!-- Estado normal (no seleccionado) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rosaLeve" />
            <corners android:radius="25dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/rosaFuerte" />
            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="8dp"
                android:bottom="8dp" />
        </shape>
    </item>

</selector>
