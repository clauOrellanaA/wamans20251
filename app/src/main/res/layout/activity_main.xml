<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rosaLeve"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/glowly_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/glowly"
        android:textSize="75sp"
        android:fontFamily="@font/childa"
        android:textColor="@color/casiguindo"
        android:layout_marginTop="230sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/boton_empezar_main"
        style="@style/TituloSeccionRosa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginStart="50dp"
        android:backgroundTint="@color/objuno"
        android:text="Empezar"
        app:layout_constraintStart_toStartOf="@id/glowly_main"
        app:layout_constraintTop_toBottomOf="@id/glowly_main" />

</androidx.constraintlayout.widget.ConstraintLayout>